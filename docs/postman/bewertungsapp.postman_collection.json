              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status ist 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Antwort enthaelt das angeforderte Team', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(String(json.id)).to.eql(pm.environment.get('teamId'));",
                  "});"
